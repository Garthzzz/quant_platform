{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Lab reading phase output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase_key",
    "result_kind",
    "payload",
    "evidence_locators"
  ],
  "properties": {
    "schema_version": {"const": "paper-reading-phase-output/v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "phase_key": {
      "enum": ["problem", "method", "experiment", "synthesis"]
    },
    "result_kind": {
      "enum": ["problem", "method", "experiment", "synthesis"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "claims", "limitations"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
        "claims": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "evidence_locators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_version_id",
          "content_sha256",
          "page",
          "locator",
          "excerpt"
        ],
        "properties": {
          "paper_version_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "page": {"type": "integer", "minimum": 1, "maximum": 100000},
          "locator": {"type": "string", "pattern": "^pdf-page:[1-9][0-9]*$"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
