{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research-hub.local/schemas/release_closure_gate_observation.schema.json",
  "title": "Quant Research Hub closure gate observation v2 managed inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "gate_role", "sealed_at", "result_artifact", "subject_artifacts", "support_artifacts", "observation_sha256"],
  "properties": {
    "schema_version": {"const": "qrh-closure-gate-observation/v2-managed-inputs"},
    "observation_id": {"$ref": "#/$defs/id"},
    "gate_role": {"$ref": "#/$defs/gate_role"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "result_artifact": {"$ref": "#/$defs/artifact_ref"},
    "subject_artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "support_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 122,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "observation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"gate_role": {"const": "full_replay_and_comment_lifecycle"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-full-replay-and-comment-lifecycle-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "failure_and_incremental_matrix"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-failure-and-incremental-matrix-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "web_search_mcp_snapshot_consistency"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-web-search-mcp-snapshot-consistency-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "independent_verification"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-independent-verification-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "shared_state_schema_compatibility"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-shared-state-schema-compatibility-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "active_prior_active_drill"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-active-prior-active-drill-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "retention_closure"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-retention-closure-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "runbook_drills_and_quality_report"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-runbook-drills-and-quality-report-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "revocation_surface"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-revocation-surface-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "identity_graph_negative_fixtures"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-identity-graph-negative-fixtures-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "repository_private_observation"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-repository-private-observation-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "private_controls_revalidation"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-private-controls-revalidation-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "private_exact_sha_ci"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-private-exact-sha-ci-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "private_candidate_only"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-private-candidate-only-result/v1"}}}}}},
    {"if": {"properties": {"gate_role": {"const": "production_identity_unchanged"}}, "required": ["gate_role"]}, "then": {"properties": {"result_artifact": {"$ref": "#/$defs/artifact_ref", "properties": {"artifact_kind": {"const": "canonical_json"}, "schema_version": {"const": "qrh-closure-production-identity-unchanged-result/v1"}}}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,179}$"},
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "gate_role": {
      "enum": [
        "full_replay_and_comment_lifecycle",
        "failure_and_incremental_matrix",
        "web_search_mcp_snapshot_consistency",
        "independent_verification",
        "shared_state_schema_compatibility",
        "active_prior_active_drill",
        "retention_closure",
        "runbook_drills_and_quality_report",
        "revocation_surface",
        "identity_graph_negative_fixtures",
        "repository_private_observation",
        "private_controls_revalidation",
        "private_exact_sha_ci",
        "private_candidate_only",
        "production_identity_unchanged"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_sha256", "snapshot_id"],
      "properties": {
        "release_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"$ref": "#/$defs/id"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_release", "prior_release", "state_identity_sha256"],
      "properties": {
        "active_release": {"$ref": "#/$defs/release"},
        "prior_release": {"$ref": "#/$defs/release"},
        "state_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "independent"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 180},
        "independent": {"type": "boolean"}
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "artifact_kind", "schema_version", "sha256", "size_bytes", "observed_at"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "artifact_kind": {"enum": ["canonical_json", "opaque_binary"]},
        "schema_version": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_kind": {"const": "canonical_json"}}},
          "then": {"properties": {"schema_version": {"type": "string", "minLength": 1, "maxLength": 180}}}
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "opaque_binary"}}},
          "then": {"properties": {"schema_version": {"type": "null"}}}
        }
      ]
    }
  }
}
