{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research-hub.local/schema/vm-deploy-runtime-v1.json",
  "title": "Quant Research Hub fixed VM deployment runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_name",
    "base_url",
    "listen_host",
    "port",
    "critical_paths",
    "writer_authority",
    "service_entry_relative_path",
    "application_source_relative_path",
    "archive_root_relative_path",
    "var_root_relative_path",
    "migration_root_relative_path",
    "access_password_digest_path",
    "session_key_path",
    "comment_database_path",
    "workspace_database_path",
    "write_paths"
  ],
  "properties": {
    "schema_version": {"const": "qrh-vm-deploy-runtime/v1"},
    "service_name": {"const": "QuantResearchHub"},
    "base_url": {"const": "http://127.0.0.1:8765"},
    "listen_host": {"const": "0.0.0.0"},
    "port": {"const": 8765},
    "critical_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/[^?]*$"}
    },
    "writer_authority": {"const": "D-active"},
    "service_entry_relative_path": {"const": "tooling/python/Lib/site-packages/quant_hub/ops/service_entry.py"},
    "application_source_relative_path": {"type": "string", "pattern": "^[^\\\\/][^\\\\]*$"},
    "archive_root_relative_path": {"type": "string", "pattern": "^[^\\\\/][^\\\\]*$"},
    "var_root_relative_path": {"type": "string", "pattern": "^[^\\\\/][^\\\\]*$"},
    "migration_root_relative_path": {"type": "string", "pattern": "^[^\\\\/][^\\\\]*$"},
    "access_password_digest_path": {"const": "state/viewer_access_password.digest"},
    "session_key_path": {"const": "state/viewer_secret.key"},
    "comment_database_path": {"const": "state/comments.sqlite3"},
    "workspace_database_path": {"const": "state/research_workspace.sqlite3"},
    "write_paths": {
      "description": "Closed production VM write namespace; runtime validation requires exact equality with production_vm_write_set.json.",
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^D:\\\\quant\\\\quant_platform\\\\(audit|checkout|control|incoming|locks|logs|releases|state|tmp|tooling)$"
      }
    }
  }
}
