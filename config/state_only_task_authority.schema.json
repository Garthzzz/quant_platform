{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research-hub.local/schemas/state_only_task_authority.schema.json",
  "title": "Quant Research Hub state-only Scheduler authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "authorized_at", "authority", "repository", "release", "paths", "bytes", "failure_domain_attestation_sha256", "authority_sha256"],
  "properties": {
    "schema_version": {"const": "qrh-state-only-scheduled-task-authority/v1"},
    "authorization_id": {"type": "string", "pattern": "^task-authority-[0-9a-f]{32}$"},
    "authorized_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "stage5_exact_identity"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "full_name", "commit_sha", "tracked_tree_sha256"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "full_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tracked_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "release": {"$ref": "#/$defs/release"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "config_path", "operational_root", "recovery_root", "operational_python", "failure_domain_attestation_path"],
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "config_path": {"type": "string", "minLength": 1},
        "operational_root": {"type": "string", "minLength": 1},
        "recovery_root": {"type": "string", "minLength": 1},
        "operational_python": {"type": "string", "minLength": 1},
        "failure_domain_attestation_path": {"type": "string", "minLength": 1}
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "operational_python_sha256"],
      "properties": {
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "operational_python_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "failure_domain_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "authority_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,179}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_sha256", "snapshot_id"],
      "properties": {
        "release_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
